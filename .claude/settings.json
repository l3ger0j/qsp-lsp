      "Bash(npx @vscode/vsce publish:*)",
      "Bash(npx tree-sitter init:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
