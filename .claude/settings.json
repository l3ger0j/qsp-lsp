{
  "permissions": {
    "deny": [
      "Edit(/tree-sitter-qsp/src/parser.c)",
      "Edit(/tree-sitter-qsp/src/grammar.json)",
      "Edit(/tree-sitter-qsp/src/node-types.json)",
      "Edit(/tree-sitter-qsp/src/tree_sitter/**)",
      "Edit(/tree-sitter-qsp/**/*.wasm)",
      "Read(/tree-sitter-qsp/src/parser.c)",

      "Edit(/out/**)",
      "Edit(/vendor/**)",
